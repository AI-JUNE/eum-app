# ============================================================================
# GitHub Actions CI 템플릿 — [승인 필요: 활성화 전 배치 금지]
#
# 배치 방법(사람이 수행):
#   1) 푸시에 쓰는 토큰에 `workflow` 스코프가 있는지 확인한다.
#      스코프가 없으면 .github/workflows/* 를 포함한 푸시가 통째로 거부되어
#      AutoPush 가 멈춘다. 확인 전에는 절대 옮기지 않는다.
#   2) 이 파일을 .github/workflows/ci.yml 로 복사한다.
#   3) 첫 실행 후 Actions 탭에서 결과를 확인한다.
#
# 로컬에서는 스코프와 무관하게 `npm run ci` 로 동일한 검증을 수행할 수 있다.
# ============================================================================
name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - name: 의존성 설치
        run: npm ci
      - name: 통합 검증(빌드 + 테스트 + 복구 리허설)
        run: npm run ci
